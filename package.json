{
  "name": "aqa-advanced",
  "version": "1.0.0",
  "description": "This project contains advanced QA automation exercises and practice tasks.",
  "main": "index.js",
  "scripts": {
    "test": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "api_tests_lesson15": "npx jest signIn.test.js && npx jest carList.test.js && npx jest addCar.test.js",
    "allure:report": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "playwright:test": "npx playwright test",
    "playwright:headed": "npx playwright test --headed",
    "playwright:ui": "npx playwright test --ui",
    "playwright:qauto": "npx playwright test --project=qauto-chromium",
    "playwright:qauto2": "npx playwright test --project=qauto2-chromium",
    "playwright:all": "npx playwright test",
    "playwright:ui:qauto": "npx playwright test --ui --project=qauto-chromium",
    "playwright:ui:qauto2": "npx playwright test --ui --project=qauto2-chromium"
  },
  "author": "Inna Logvin",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.16.1",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.0.1",
    "allure-commandline": "^2.43.0",
    "babel-jest": "^30.4.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-html-reporters": "^3.1.7",
    "lint-staged": "^17.0.5"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  }
}
